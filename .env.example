COMPOSE_PROJECT_NAME=ci-runner
GITHUB_CONFIG_URL=https://github.com/OWNER/REPOSITORY
SCALE_SET_NAME=ci-mac-arm64-smoke
# Download the successful cloud build's deployment artifact for a complete pair.
CONTROLLER_IMAGE=
RUNNER_IMAGE=
IMAGE_REVISION=
POSTGRES_IMAGE=
GITHUB_TOKEN_FILE=./.secrets/github-token
RUNNER_IDLE_TIMEOUT_SECONDS=300
RUNNER_MAX_LIFETIME_SECONDS=3600
# Explicit trusted-fleet opt-in only; default public smoke remains manual.
# Supported: workflow_dispatch,push,pull_request,pull_request_target,schedule
RUNNER_ALLOWED_EVENTS=workflow_dispatch
# Dedicated audited manual-only fleet; public/fork fleets keep off.
DEPENDENCY_CACHE_MODE=off
# Explicit trust/ref lane, e.g. reviewed-main; candidates need another deployment.
DEPENDENCY_CACHE_TRUST_LANE=
# Empty retains generic ci database behavior. Lowercase identifier prefix ending
# in underscore, at most 31 bytes; non-empty provisions a non-admin owned pair.
POSTGRES_DATABASE_PREFIX=
# Optional trusted HTTP proxy for public egress; jobs cannot select destinations through it.
PUBLIC_EGRESS_UPSTREAM_PROXY=
# Optional trusted HTTPS JSON DNS resolver for per-job public gateways only.
# Example: https://dns.alidns.com/resolve; no Mac/system DNS changes.
PUBLIC_EGRESS_DOH_URL=

# Readable persistent volume name; ownership remains enforced by labels.
DEPENDENCY_CACHE_VOLUME=ci-deps-linux-arm64-cache
